<Page
    x:Class="DeviceCenterPreview.App.Views.DeviceCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeviceCenterPreview.App.Controls"
    NavigationCacheMode="Required">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Padding="34,32,34,26" Spacing="24" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="我的设备" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:Name="ConnectionSummary" Grid.Column="1" VerticalAlignment="Center"
                           Style="{StaticResource AppPageSubtitleStyle}" />
                <Button Grid.Column="2" Content="刷新鼠标" Style="{StaticResource AppSecondaryButtonStyle}"
                        VerticalAlignment="Center" Click="RefreshMouse_Click" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Height="340" VerticalAlignment="Top" CornerRadius="14"
                        Background="{ThemeResource AppCardBrush}" IsHitTestVisible="False" />
                <Button Grid.Column="0" AutomationProperties.Name="打开耳机设置"
                        Style="{StaticResource AppGalleryButtonStyle}" Click="HeadsetCard_Click">
                    <StackPanel Spacing="12">
                        <Grid Height="340" Padding="14,12,14,24">
                            <Image Source="ms-appx:///Assets/Devices/yuandao-case.png" Width="216" Height="250"
                                   VerticalAlignment="Bottom" Stretch="Uniform" />
                        </Grid>
                        <StackPanel Spacing="8" Padding="16,0,16,12">
                            <TextBlock x:Name="HeadsetName" Text="耳机" Style="{StaticResource AppCardTitleStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:StatusChip x:Name="HeadsetStatusChip" />
                                <TextBlock x:Name="HeadsetBattery" VerticalAlignment="Center"
                                           Style="{StaticResource AppBodyStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="HeadsetDetail" Style="{StaticResource AppCardFootnoteStyle}" />
                            <TextBlock Text="进入耳机设置 →" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppIonBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" AutomationProperties.Name="打开鼠标设置"
                        Style="{StaticResource AppGalleryButtonStyle}" Click="MouseCard_Click">
                    <StackPanel Spacing="12">
                        <Grid Height="340" Padding="14,12,14,24">
                            <Grid VerticalAlignment="Bottom" Height="264">
                                <Image x:Name="HubMouseImage" Width="204" MaxHeight="250" Stretch="Uniform" />
                                <FontIcon x:Name="HubMouseIcon" FontSize="86" Visibility="Collapsed"
                                          Glyph="{StaticResource AppIconMouseGlyph}"
                                          Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </Grid>
                        </Grid>
                        <StackPanel Spacing="8" Padding="16,0,16,12">
                            <TextBlock x:Name="MouseName" Text="鼠标" Style="{StaticResource AppCardTitleStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:StatusChip x:Name="MouseStatusChip" />
                                <TextBlock x:Name="MouseBattery" VerticalAlignment="Center"
                                           Style="{StaticResource AppBodyStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="MouseDetail" Style="{StaticResource AppCardFootnoteStyle}" />
                            <TextBlock Text="进入鼠标设置 →" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppIonBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" AutomationProperties.Name="打开遥控器设置"
                        Style="{StaticResource AppGalleryButtonStyle}" Click="RemoteCard_Click">
                    <StackPanel Spacing="12">
                        <Grid Height="340" Padding="14,12,14,24">
                            <Image Source="ms-appx:///Assets/Devices/rc003.png" Height="296" MaxWidth="164"
                                   VerticalAlignment="Bottom" Stretch="Uniform" />
                        </Grid>
                        <StackPanel Spacing="8" Padding="16,0,16,12">
                            <TextBlock x:Name="RemoteName" Text="遥控器" Style="{StaticResource AppCardTitleStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:StatusChip x:Name="RemoteStatusChip" />
                                <TextBlock x:Name="RemoteBattery" VerticalAlignment="Center"
                                           Style="{StaticResource AppBodyStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="RemoteDetail" Style="{StaticResource AppCardFootnoteStyle}" />
                            <TextBlock Text="进入遥控器设置 →" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppIonBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
