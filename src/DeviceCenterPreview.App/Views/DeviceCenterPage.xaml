<Page
    x:Class="DeviceCenterPreview.App.Views.DeviceCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="HubCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AppCardGlassBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="HubNameStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        </Style>
        <Style x:Key="HubMetaStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppTextFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HubBatteryStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppDisplayFont}" />
            <Setter Property="FontSize" Value="46" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        </Style>
        <Style x:Key="HubFactStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppTextFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HubOpenStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppTextFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageContent" Padding="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid>
            <StackPanel Spacing="3">
                <TextBlock Text="设备" Style="{StaticResource BenchPageTitleStyle}" FontSize="30" LineHeight="36" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="HeaderDot" Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{ThemeResource AppOfflineBrush}" />
                    <TextBlock x:Name="HeaderSubtitle" Text="三台设备的状态与电量"
                               Style="{StaticResource BenchMetaStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="自动同步 15 秒" Style="{StaticResource BenchFootnoteStyle}"
                           VerticalAlignment="Center" />
                <Button x:Name="RefreshButton" Style="{StaticResource BenchOutlineButtonStyle}"
                        Click="Refresh_Click" ToolTipService.ToolTip="刷新鼠标读数"
                        AutomationProperties.Name="刷新">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{StaticResource AppIconRefreshGlyph}" FontSize="12" />
                        <TextBlock Text="刷新" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 三张等权设备卡 -->
        <Grid Grid.Row="1" ColumnSpacing="14" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 耳机 -->
            <Button x:Name="HeadsetColumn" Grid.Column="0" Tag="headset" Style="{StaticResource HubCardButtonStyle}"
                    Click="Column_Click" AutomationProperties.Name="打开耳机工作区">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{ThemeResource AppHeadsetBrush}" Opacity="0.85" />
                    <Grid Grid.Row="1" Margin="20,16,20,0">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="HeadsetName" Text="耳机" Style="{StaticResource HubNameStyle}" />
                            <TextBlock x:Name="HeadsetMeta" Text="SPP" Style="{StaticResource HubMetaStyle}" />
                        </StackPanel>
                        <Ellipse x:Name="HeadsetDot" Width="7" Height="7" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Margin="0,6,0,0" Fill="{ThemeResource AppOfflineBrush}" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="12,0,12,0">
                        <Image Source="ms-appx:///Assets/Devices/yuandao-case.png"
                               MaxHeight="220" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="20,0,20,18">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock x:Name="HeadsetBattery" Text="—" Style="{StaticResource HubBatteryStyle}" />
                            <TextBlock x:Name="HeadsetBatterySuffix" Text="%" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,7" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,7,0,0">
                            <TextBlock x:Name="HeadsetLeftText" Text="左耳 —" Style="{StaticResource HubMetaStyle}" />
                            <TextBlock x:Name="HeadsetRightText" Text="右耳 —" Style="{StaticResource HubMetaStyle}" />
                            <TextBlock x:Name="HeadsetCaseText" Text="充电盒 —" Style="{StaticResource HubMetaStyle}" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="打开耳机" Style="{StaticResource HubOpenStyle}" />
                            <TextBlock x:Name="HeadsetFact" Text="—" Style="{StaticResource HubFactStyle}"
                                       HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 鼠标 -->
            <Button x:Name="MouseColumn" Grid.Column="1" Tag="mouse" Style="{StaticResource HubCardButtonStyle}"
                    Click="Column_Click" AutomationProperties.Name="打开鼠标工作区">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{ThemeResource AppMouseBrush}" Opacity="0.85" />
                    <Grid Grid.Row="1" Margin="20,16,20,0">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="MouseName" Text="鼠标" Style="{StaticResource HubNameStyle}" />
                            <TextBlock x:Name="MouseMeta" Text="HID++" Style="{StaticResource HubMetaStyle}" />
                        </StackPanel>
                        <Ellipse x:Name="MouseDot" Width="7" Height="7" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Margin="0,6,0,0" Fill="{ThemeResource AppOfflineBrush}" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="12,0,12,0">
                        <Image Source="ms-appx:///Assets/Devices/g304.png"
                               MaxHeight="172" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="20,0,20,18">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock x:Name="MouseBattery" Text="—" Style="{StaticResource HubBatteryStyle}" />
                            <TextBlock x:Name="MouseBatterySuffix" Text="%" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,7" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="打开鼠标" Style="{StaticResource HubOpenStyle}" />
                            <TextBlock x:Name="MouseFact" Text="—" Style="{StaticResource HubFactStyle}"
                                       HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- 遥控器 -->
            <Button x:Name="RemoteColumn" Grid.Column="2" Tag="remote" Style="{StaticResource HubCardButtonStyle}"
                    Click="Column_Click" AutomationProperties.Name="打开遥控器工作区">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{ThemeResource AppRemoteBrush}" Opacity="0.85" />
                    <Grid Grid.Row="1" Margin="20,16,20,0">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="RemoteName" Text="遥控器" Style="{StaticResource HubNameStyle}" />
                            <TextBlock x:Name="RemoteMeta" Text="BLE" Style="{StaticResource HubMetaStyle}" />
                        </StackPanel>
                        <Ellipse x:Name="RemoteDot" Width="7" Height="7" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Margin="0,6,0,0" Fill="{ThemeResource AppOfflineBrush}" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="12,0,12,0">
                        <Image Source="ms-appx:///Assets/Devices/rc003.png"
                               MaxHeight="200" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="20,0,20,18">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock x:Name="RemoteBattery" Text="—" Style="{StaticResource HubBatteryStyle}" />
                            <TextBlock x:Name="RemoteBatterySuffix" Text="%" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,7" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="打开遥控器" Style="{StaticResource HubOpenStyle}" />
                            <TextBlock x:Name="RemoteFact" Text="—" Style="{StaticResource HubFactStyle}"
                                       HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>

        <Grid x:Name="OtherDevicesSection" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="其他设备" Style="{StaticResource BenchLabelStyle}" />
                    <TextBlock x:Name="OtherDevicesCount" Style="{StaticResource BenchFootnoteStyle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Margin="0,6,0,0"
                        BorderBrush="{ThemeResource AppBorderSubtleBrush}" BorderThickness="1">
                    <Grid Padding="12,2,12,2" ColumnSpacing="16" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="OtherRow0" Grid.Row="0" Grid.Column="0"
                                Padding="0,3,0,3" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OtherIcon0" Glyph="{StaticResource AppIconBatteryGlyph}"
                                          FontSize="13" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="OtherName0" Grid.Column="1" Text="—" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherPercent0" Grid.Column="2" Text="—" FontSize="13"
                                           FontWeight="SemiBold" MinWidth="38" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherState0" Grid.Column="3" Text=""
                                           Style="{StaticResource BenchFootnoteStyle}" MinWidth="52"
                                           TextWrapping="NoWrap"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="OtherRow1" Grid.Row="0" Grid.Column="1"
                                Padding="0,3,0,3" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OtherIcon1" Glyph="{StaticResource AppIconBatteryGlyph}"
                                          FontSize="13" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="OtherName1" Grid.Column="1" Text="—" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherPercent1" Grid.Column="2" Text="—" FontSize="13"
                                           FontWeight="SemiBold" MinWidth="38" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherState1" Grid.Column="3" Text=""
                                           Style="{StaticResource BenchFootnoteStyle}" MinWidth="52"
                                           TextWrapping="NoWrap"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="OtherRow2" Grid.Row="0" Grid.Column="2"
                                Padding="0,3,0,3" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OtherIcon2" Glyph="{StaticResource AppIconBatteryGlyph}"
                                          FontSize="13" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="OtherName2" Grid.Column="1" Text="—" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherPercent2" Grid.Column="2" Text="—" FontSize="13"
                                           FontWeight="SemiBold" MinWidth="38" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherState2" Grid.Column="3" Text=""
                                           Style="{StaticResource BenchFootnoteStyle}" MinWidth="52"
                                           TextWrapping="NoWrap"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="OtherRow3" Grid.Row="1" Grid.Column="0"
                                Padding="0,3,0,3" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OtherIcon3" Glyph="{StaticResource AppIconBatteryGlyph}"
                                          FontSize="13" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="OtherName3" Grid.Column="1" Text="—" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherPercent3" Grid.Column="2" Text="—" FontSize="13"
                                           FontWeight="SemiBold" MinWidth="38" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherState3" Grid.Column="3" Text=""
                                           Style="{StaticResource BenchFootnoteStyle}" MinWidth="52"
                                           TextWrapping="NoWrap"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="OtherRow4" Grid.Row="1" Grid.Column="1"
                                Padding="0,3,0,3" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OtherIcon4" Glyph="{StaticResource AppIconBatteryGlyph}"
                                          FontSize="13" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="OtherName4" Grid.Column="1" Text="—" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherPercent4" Grid.Column="2" Text="—" FontSize="13"
                                           FontWeight="SemiBold" MinWidth="38" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherState4" Grid.Column="3" Text=""
                                           Style="{StaticResource BenchFootnoteStyle}" MinWidth="52"
                                           TextWrapping="NoWrap"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="OtherRow5" Grid.Row="1" Grid.Column="2"
                                Padding="0,3,0,3" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="OtherIcon5" Glyph="{StaticResource AppIconBatteryGlyph}"
                                          FontSize="13" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="OtherName5" Grid.Column="1" Text="—" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherPercent5" Grid.Column="2" Text="—" FontSize="13"
                                           FontWeight="SemiBold" MinWidth="38" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock x:Name="OtherState5" Grid.Column="3" Text=""
                                           Style="{StaticResource BenchFootnoteStyle}" MinWidth="52"
                                           TextWrapping="NoWrap"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        <!-- 系统条 -->
        <Border Grid.Row="3" BorderBrush="{ThemeResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="0,10,0,0" Margin="0,16,0,0">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="本地引擎" Style="{StaticResource BenchLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="{ThemeResource AppSuccessBrush}" />
                        <TextBlock Text="运行中" Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="同步" Style="{StaticResource BenchLabelStyle}" />
                    <TextBlock Text="每 15 秒自动读取" Style="{StaticResource BenchValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="数据" Style="{StaticResource BenchLabelStyle}" />
                    <TextBlock Text="全部来自真实设备" Style="{StaticResource BenchValueStyle}" />
                </StackPanel>
                <Button Grid.Column="3" Content="打开设置"
                        Style="{StaticResource BenchGhostButtonStyle}"
                        VerticalAlignment="Bottom" Click="OpenSettings_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
