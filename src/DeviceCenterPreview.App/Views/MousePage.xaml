<Page
    x:Class="DeviceCenterPreview.App.Views.MousePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeviceCenterPreview.App.Controls"
    NavigationCacheMode="Required">

    <!--
        鼠标工作区：页头 + 仪表条 + 三块互斥工作区（灵敏度 / 按键 / 板载与设备）。
        同一屏只显示一个工作区的控件，避免整页都是表单。
    -->
    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Padding="32,28,32,24" Spacing="0">

            <!-- 页头 -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="设备 02 · 指针与按键" Style="{StaticResource BenchLabelStyle}" />
                    <TextBlock x:Name="TitleText" Text="鼠标"
                               Style="{StaticResource BenchPageTitleStyle}" />
                    <TextBlock x:Name="SubtitleText" Text="正在读取…"
                               Style="{StaticResource BenchMetaStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="刷新鼠标"
                            Style="{StaticResource BenchOutlineButtonStyle}"
                            Click="Refresh_Click" />
                    <Button x:Name="ApplyButton" Content="应用设置"
                            Style="{StaticResource BenchInkButtonStyle}"
                            Click="Apply_Click" />
                </StackPanel>
            </Grid>

            <!-- 仪表条 -->
            <Border BorderBrush="{ThemeResource AppBorderSubtleBrush}" BorderThickness="1,1,1,1"
                    Margin="0,18,0,0" Padding="4,0">
                <Grid Height="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="18,0" Spacing="2">
                        <TextBlock Text="DPI" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="HeroDpiText" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0" Spacing="2">
                        <TextBlock Text="轮询率" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="HeroPollingText" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="18,0" Spacing="2">
                        <TextBlock Text="板载配置" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="HeroModeText" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                    <Border Grid.Column="5" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="18,0" Spacing="2">
                        <TextBlock Text="电量" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="HeroBatteryText" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                    <Border Grid.Column="7" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="18,0" Spacing="2">
                        <TextBlock Text="写入" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="HeroWriteText" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ControlBanner" Background="{ThemeResource AppWarningTintBrush}"
                    CornerRadius="6" Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ControlBannerText"
                           Style="{StaticResource BenchFootnoteStyle}"
                           Foreground="{ThemeResource AppWarningBrush}" />
            </Border>

            <!-- 工作区切换 -->
            <Border Background="{ThemeResource AppInsetBrush}" CornerRadius="6" Padding="3"
                    HorizontalAlignment="Left" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="WorkspaceDpi" Content="灵敏度" Tag="dpi"
                            Style="{StaticResource BenchSegmentButtonStyle}"
                            Click="Workspace_Changed" />
                    <Button x:Name="WorkspaceButtons" Content="按键" Tag="buttons"
                            Style="{StaticResource BenchSegmentButtonStyle}"
                            Click="Workspace_Changed" />
                    <Button x:Name="WorkspaceBoard" Content="板载与设备" Tag="board"
                            Style="{StaticResource BenchSegmentButtonStyle}"
                            Click="Workspace_Changed" />
                </StackPanel>
            </Border>

            <!-- 机身 + 工作区 -->
            <Grid Margin="0,22,0,0" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 设备台 -->
                <Border Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top" Style="{StaticResource BenchPanelStyle}" Padding="20">
                    <StackPanel Spacing="0">
                    <TextBlock Text="设备" Style="{StaticResource BenchLabelStyle}" />
                    <ComboBox x:Name="DeviceCombo" Margin="0,6,0,0"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              Style="{StaticResource BenchComboBoxStyle}"
                              SelectionChanged="DeviceCombo_SelectionChanged" />

                    <Grid Height="168" Margin="0,14,0,0">
                        <Image x:Name="MouseHeroImage" MaxHeight="156" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <FontIcon x:Name="MouseHeroIcon" Glyph="{StaticResource AppIconMouseGlyph}"
                                  FontSize="40" Visibility="Collapsed"
                                  Foreground="{ThemeResource AppMouseBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0"
                                HorizontalAlignment="Center">
                        <controls:BatteryRing x:Name="MouseRing" Size="64"
                                              RingBrush="{ThemeResource AppMouseBrush}" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="电量" Style="{StaticResource BenchLabelStyle}" />
                            <TextBlock Text="充电中会以闪电标记" Style="{StaticResource BenchFootnoteStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,18,0,14" />
                    <TextBlock Text="只对罗技 HID++ 鼠标开放读写。未支持的设备会明确标注，不伪造能力。"
                               Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource AppBorderSubtleBrush}" />

                <!-- 控制区 -->
                <Border Grid.Column="2" Margin="32,0,0,0" VerticalAlignment="Top" Style="{StaticResource BenchPanelStyle}" Padding="22">
                    <StackPanel Spacing="0">

                    <!-- 灵敏度 -->
                    <StackPanel x:Name="PerformanceCard" Spacing="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="0">
                                <TextBlock x:Name="DpiLabel" Text="当前 DPI"
                                           Style="{StaticResource BenchLabelStyle}" />
                                <TextBlock x:Name="DpiValueText" Text="—"
                                           Style="{StaticResource BenchNumberStyle}" />
                                <Slider x:Name="DpiSlider" Style="{StaticResource AppSliderStyle}"
                                        Minimum="400" Maximum="8000" StepFrequency="100"
                                        ValueChanged="Dpi_ValueChanged" Margin="0,2,0,0" />
                                <Grid Margin="4,-4,4,0">
                                    <TextBlock x:Name="DpiMinText" Text="400"
                                               Style="{StaticResource BenchFootnoteStyle}" />
                                    <TextBlock x:Name="DpiMaxText" Text="8000"
                                               Style="{StaticResource BenchFootnoteStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="DpiHintText"
                                           Style="{StaticResource BenchFootnoteStyle}"
                                           Visibility="Collapsed" Margin="0,8,0,0" />
                                <StackPanel Spacing="4" Margin="0,16,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="轮询率" Style="{StaticResource BenchLabelStyle}" />
                                    <ComboBox x:Name="PollingCombo" Width="240"
                                              SelectionChanged="Polling_SelectionChanged"
                                              Style="{StaticResource BenchComboBoxStyle}" />
                                </StackPanel>
                                <TextBlock Text="拖动滑杆后点右上角「应用设置」写入；写入走先读 → 写 → 回读校验。"
                                           Style="{StaticResource BenchFootnoteStyle}" Margin="0,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 按键 -->
                    <StackPanel x:Name="MappingPanel" Spacing="0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="0">
                                <Grid>
                                    <TextBlock Text="按键 → 动作" Style="{StaticResource BenchLabelStyle}" />
                                    <TextBlock x:Name="ButtonCountText"
                                               Style="{StaticResource BenchFootnoteStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ScrollViewer x:Name="ButtonMappingScroll" Margin="0,8,0,0"
                                              HorizontalScrollMode="Disabled"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled">
                                    <Grid x:Name="ButtonMappingPanel" ColumnSpacing="24" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="0" />
                                        </Grid.RowDefinitions>
                                        <Grid x:Name="ButtonRow1" Grid.Row="0" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel1" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo1" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow2" Grid.Row="0" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel2" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo2" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow3" Grid.Row="1" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel3" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo3" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow4" Grid.Row="1" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel4" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo4" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow5" Grid.Row="2" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel5" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo5" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow6" Grid.Row="2" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel6" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo6" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow7" Grid.Row="3" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel7" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo7" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow8" Grid.Row="3" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel8" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo8" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow9" Grid.Row="4" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel9" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo9" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow10" Grid.Row="4" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel10" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo10" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow11" Grid.Row="5" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel11" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo11" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow12" Grid.Row="5" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel12" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo12" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow13" Grid.Row="6" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel13" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo13" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow14" Grid.Row="6" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel14" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo14" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow15" Grid.Row="7" Grid.Column="0" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel15" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo15" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                        <Grid x:Name="ButtonRow16" Grid.Row="7" Grid.Column="1" ColumnSpacing="8" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ButtonLabel16" VerticalAlignment="Center" Style="{StaticResource BenchFootnoteStyle}" />
                                            <ComboBox x:Name="ButtonCombo16" Grid.Column="1" Style="{StaticResource BenchComboBoxStyle}" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                                <TextBlock x:Name="ButtonMappingEmpty"
                                           Style="{StaticResource BenchFootnoteStyle}" Margin="0,10,0,0" />
                                <TextBlock x:Name="ButtonMappingHint"
                                           Style="{StaticResource BenchFootnoteStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 板载与设备 -->
                    <StackPanel x:Name="BoardPanel" Spacing="0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Spacing="0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="OnboardToggle"
                                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                                  Toggled="Onboard_Toggled" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="板载模式" Style="{StaticResource BenchValueStyle}" />
                                        <TextBlock Text="开启后 DPI 档位由鼠标固件执行"
                                                   Style="{StaticResource BenchFootnoteStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4" Margin="0,14,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="当前档位" Style="{StaticResource BenchLabelStyle}" />
                                    <ComboBox x:Name="StageIndexCombo" Width="180"
                                              SelectionChanged="StageIndex_SelectionChanged"
                                              Style="{StaticResource BenchComboBoxStyle}" />
                                </StackPanel>
                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="DPI 档位" Style="{StaticResource BenchLabelStyle}" />
                                    <TextBlock Text="0 表示未使用；写入后回读校验"
                                               Style="{StaticResource BenchFootnoteStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid x:Name="DpiStagePanel" Margin="0,6,0,0" ColumnSpacing="8"
                                      HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="1" Style="{StaticResource BenchFootnoteStyle}" />
                                        <TextBox x:Name="StageBox1" TextChanged="StageBox_TextChanged"
                                                 Style="{StaticResource BenchTextBoxStyle}"
                                                 TextAlignment="Center" PlaceholderText="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="2" Style="{StaticResource BenchFootnoteStyle}" />
                                        <TextBox x:Name="StageBox2" TextChanged="StageBox_TextChanged"
                                                 Style="{StaticResource BenchTextBoxStyle}"
                                                 TextAlignment="Center" PlaceholderText="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="3" Style="{StaticResource BenchFootnoteStyle}" />
                                        <TextBox x:Name="StageBox3" TextChanged="StageBox_TextChanged"
                                                 Style="{StaticResource BenchTextBoxStyle}"
                                                 TextAlignment="Center" PlaceholderText="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="3">
                                        <TextBlock Text="4" Style="{StaticResource BenchFootnoteStyle}" />
                                        <TextBox x:Name="StageBox4" TextChanged="StageBox_TextChanged"
                                                 Style="{StaticResource BenchTextBoxStyle}"
                                                 TextAlignment="Center" PlaceholderText="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="3">
                                        <TextBlock Text="5" Style="{StaticResource BenchFootnoteStyle}" />
                                        <TextBox x:Name="StageBox5" TextChanged="StageBox_TextChanged"
                                                 Style="{StaticResource BenchTextBoxStyle}"
                                                 TextAlignment="Center" PlaceholderText="0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,16,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="配置名称" Style="{StaticResource BenchLabelStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="ProfileNameBox" Grid.Column="1" MaxLength="24"
                                             Style="{StaticResource BenchTextBoxStyle}"
                                             PlaceholderText="PROFILE_NAME_DEFAULT" />
                                </Grid>
                                <TextBlock x:Name="ProfileInfoText"
                                           Style="{StaticResource BenchFootnoteStyle}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,18,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DeviceInfoText" Grid.Column="1"
                                       Style="{StaticResource BenchFootnoteStyle}" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="SaveStatus" Text="" Style="{StaticResource BenchFootnoteStyle}"
                               Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
