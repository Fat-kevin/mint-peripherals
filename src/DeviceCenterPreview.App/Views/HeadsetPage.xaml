<Page
    x:Class="DeviceCenterPreview.App.Views.HeadsetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <!--
        耳机：页头 → 仪表条（白色面板，5 格分隔）→ 左设备面板 + 右两张功能面板。
        分区用白色面板 + 20 内边距隔开，标题和正文都放大一档，保证层次读得出来。
    -->
    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Padding="30,20,30,16" Spacing="0">

            <!-- 页头 -->
            <Grid Margin="0,0,0,14">
                <StackPanel Spacing="5">
                    <TextBlock Text="设备 01 · 音频控制" Style="{StaticResource BenchLabelStyle}" />
                    <TextBlock x:Name="PageTitleText" Text="耳机"
                               Style="{StaticResource BenchPageTitleStyle}" />
                    <TextBlock x:Name="PageMetaText" Text="正在读取…"
                               Style="{StaticResource BenchMetaStyle}" />
                </StackPanel>
                <Button x:Name="FindButton" Content="查找耳机"
                        Style="{StaticResource BenchInkButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Find_Click" />
            </Grid>

            <!-- 仪表条 -->
            <Border Style="{StaticResource BenchPanelStyle}" Padding="0">
                <Grid Height="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="20,0" Spacing="5">
                        <TextBlock Text="连接" Style="{StaticResource BenchLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="ConnDot" Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{ThemeResource AppOfflineBrush}" />
                            <TextBlock x:Name="ChipConn" Text="—"
                                       Style="{StaticResource BenchValueStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="0,14" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0" Spacing="5">
                        <TextBlock Text="固件" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="ChipFirmware" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                    <Border Grid.Column="3" Margin="0,14" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="20,0" Spacing="5">
                        <TextBlock Text="降噪" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="ChipAnc" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                    <Border Grid.Column="5" Margin="0,14" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="20,0" Spacing="5">
                        <TextBlock Text="EQ" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="ChipEq" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                    <Border Grid.Column="7" Margin="0,14" Background="{ThemeResource AppBorderSubtleBrush}" />
                    <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="20,0" Spacing="5">
                        <TextBlock Text="写入" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock x:Name="ChipWrite" Text="—"
                                   Style="{StaticResource BenchValueStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ControlBanner" Background="{ThemeResource AppWarningTintBrush}"
                    CornerRadius="8" Padding="14,11" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ControlBannerText"
                           Style="{StaticResource BenchFootnoteStyle}"
                           Foreground="{ThemeResource AppWarningBrush}" />
            </Border>

            <!-- 主体 -->
            <Grid Margin="0,16,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 设备面板 -->
                <Border Grid.Column="0" Style="{StaticResource BenchPanelStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="0">
                        <TextBlock Text="设备" Style="{StaticResource BenchPanelTitleStyle}" />
                        <Border Style="{StaticResource BenchPanelRuleStyle}" />

                        <Image Source="ms-appx:///Assets/Devices/yuandao-case.png"
                               MaxHeight="150" Stretch="Uniform"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="充电盒 · 左耳 · 右耳"
                                   Style="{StaticResource BenchFootnoteStyle}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />

                        <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,16,0,14" />

                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="左耳" Style="{StaticResource BenchValueStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right">
                                        <TextBlock x:Name="LeftCharging" Text="—"
                                                   Style="{StaticResource BenchFootnoteStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="LeftPercent" Text="—"
                                                   Style="{StaticResource BenchValueStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Height="6" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="LeftBarFill" Width="0*" />
                                        <ColumnDefinition x:Name="LeftBarRest" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource AppHeadsetBrush}" />
                                    <Border Grid.Column="1" Background="{ThemeResource AppRingTrackBrush}" />
                                </Grid>
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="右耳" Style="{StaticResource BenchValueStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right">
                                        <TextBlock x:Name="RightCharging" Text="—"
                                                   Style="{StaticResource BenchFootnoteStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="RightPercent" Text="—"
                                                   Style="{StaticResource BenchValueStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Height="6" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="RightBarFill" Width="0*" />
                                        <ColumnDefinition x:Name="RightBarRest" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource AppHeadsetBrush}" />
                                    <Border Grid.Column="1" Background="{ThemeResource AppRingTrackBrush}" />
                                </Grid>
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="充电盒" Style="{StaticResource BenchValueStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right">
                                        <TextBlock x:Name="CaseCharging" Text="—"
                                                   Style="{StaticResource BenchFootnoteStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="CasePercent" Text="—"
                                                   Style="{StaticResource BenchValueStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Height="6" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CaseBarFill" Width="0*" />
                                        <ColumnDefinition x:Name="CaseBarRest" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{ThemeResource AppHeadsetBrush}" />
                                    <Border Grid.Column="1" Background="{ThemeResource AppRingTrackBrush}" />
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,18,0,12" />
                        <TextBlock Text="读取与写入走 SPP。控制通道未接入时，本页控件会禁用并说明原因。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                </Border>

                <!-- 功能面板 -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!-- 降噪与音效 -->
                    <Border Style="{StaticResource BenchPanelStyle}" Padding="16">
                        <StackPanel Spacing="0">
                            <Grid>
                                <TextBlock Text="降噪与音效" Style="{StaticResource BenchPanelTitleStyle}" />
                                <TextBlock x:Name="AncHint" Text="切换后立即写入耳机"
                                           Style="{StaticResource BenchFootnoteStyle}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource BenchPanelRuleStyle}" />

                            <Grid x:Name="AncGrid" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>

                            <TextBlock Text="音效预设" Style="{StaticResource BenchLabelStyle}"
                                       Margin="0,18,0,0" />
                            <Grid x:Name="EqGrid" ColumnSpacing="10" RowSpacing="10" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 快捷功能 -->
                    <Border Style="{StaticResource BenchPanelStyle}" Padding="16">
                        <StackPanel Spacing="0">
                            <TextBlock Text="快捷功能" Style="{StaticResource BenchPanelTitleStyle}" />
                            <Border Style="{StaticResource BenchPanelRuleStyle}" />

                            <Grid ColumnSpacing="28" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="游戏模式" Style="{StaticResource BenchValueStyle}" />
                                        <TextBlock Text="优先同步性，降低输出延迟"
                                                   Style="{StaticResource BenchFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="GameModeSwitch" Grid.Column="1"
                                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Toggle_Changed" />
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="低延迟" Style="{StaticResource BenchValueStyle}" />
                                        <TextBlock Text="配合游戏模式使用"
                                                   Style="{StaticResource BenchFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LowLatencySwitch" Grid.Column="1"
                                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Toggle_Changed" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="双设备连接" Style="{StaticResource BenchValueStyle}" />
                                        <TextBlock Text="同时连接电脑与手机"
                                                   Style="{StaticResource BenchFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="DualDeviceSwitch" Grid.Column="1"
                                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Toggle_Changed" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="入耳检测" Style="{StaticResource BenchValueStyle}" />
                                        <TextBlock Text="摘下自动暂停播放"
                                                   Style="{StaticResource BenchFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="InEarSwitch" Grid.Column="1"
                                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Toggle_Changed" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="抗风噪" Style="{StaticResource BenchValueStyle}" />
                                        <TextBlock Text="降低户外风噪，可能牺牲少量解析"
                                                   Style="{StaticResource BenchFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WindNoiseSwitch" Grid.Column="1"
                                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Toggle_Changed" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SaveStatus" Text="" Style="{StaticResource BenchFootnoteStyle}"
                               Margin="2,2,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
