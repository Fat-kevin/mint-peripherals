<Page
    x:Class="DeviceCenterPreview.App.Views.HeadsetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Padding="32,26,32,24" Spacing="20"
                    HorizontalAlignment="Stretch">

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="耳机"
                                   Style="{StaticResource AppPageTitleStyle}" />
                        <TextBlock x:Name="SubtitleText"
                                   Style="{StaticResource AppPageSubtitleStyle}"
                                   TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <Button x:Name="FindButton" Grid.Column="1" Content="查找耳机"
                            Style="{StaticResource AppPrimaryButtonStyle}"
                            VerticalAlignment="Center"
                            Click="Find_Click" />
                </Grid>

            <Border x:Name="ControlBanner"
                    Style="{StaticResource AppStatusBannerStyle}"
                    Visibility="Collapsed">
                <TextBlock x:Name="ControlBannerText"
                           Style="{StaticResource AppCardFootnoteStyle}"
                           TextWrapping="Wrap" TextTrimming="None" />
            </Border>

            <Grid ColumnSpacing="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource AppCardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                    <Image Source="ms-appx:///Assets/Devices/yuandao-case.png" Width="228" Height="244"
                           Stretch="Uniform" />
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="左耳" HorizontalAlignment="Center"
                                       Style="{StaticResource AppCardLabelStyle}" />
                            <TextBlock x:Name="LeftReadout" HorizontalAlignment="Center"
                                       Style="{StaticResource AppNumericMediumStyle}" />
                            <TextBlock x:Name="LeftCharging" HorizontalAlignment="Center"
                                       Style="{StaticResource AppCardFootnoteStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="充电盒" HorizontalAlignment="Center"
                                       Style="{StaticResource AppCardLabelStyle}" />
                            <TextBlock x:Name="CaseReadout" HorizontalAlignment="Center"
                                       Style="{StaticResource AppNumericMediumStyle}" />
                            <TextBlock x:Name="CaseCharging" HorizontalAlignment="Center"
                                       Style="{StaticResource AppCardFootnoteStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="右耳" HorizontalAlignment="Center"
                                       Style="{StaticResource AppCardLabelStyle}" />
                            <TextBlock x:Name="RightReadout" HorizontalAlignment="Center"
                                       Style="{StaticResource AppNumericMediumStyle}" />
                            <TextBlock x:Name="RightCharging" HorizontalAlignment="Center"
                                       Style="{StaticResource AppCardFootnoteStyle}" />
                        </StackPanel>
                    </Grid>
                        <TextBlock x:Name="HeadsetFirmwareText" Style="{StaticResource AppCaptionStyle}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="16">
                    <TextBlock Text="降噪" Style="{StaticResource AppSectionTitleStyle}" />
                    <Grid x:Name="AncModes" ColumnSpacing="8" RowSpacing="8" />
                    <TextBlock Text="音效" Style="{StaticResource AppSectionTitleStyle}" Margin="0,6,0,0" />
                    <Grid x:Name="EqModes" ColumnSpacing="8" RowSpacing="8" />
                    <Border Height="1" Background="{ThemeResource AppBorderBrush}" Margin="0,4" />
                    <TextBlock Text="快捷开关" Style="{StaticResource AppSectionTitleStyle}" />
                        <Grid ColumnSpacing="24" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleSwitch x:Name="GameModeSwitch" Header="游戏模式"
                                          Style="{StaticResource AppToggleSwitchStyle}"
                                          Grid.Row="0" Grid.Column="0"
                                          Toggled="Toggle_Changed" />
                            <ToggleSwitch x:Name="LowLatencySwitch" Header="低延迟"
                                          Style="{StaticResource AppToggleSwitchStyle}"
                                          Grid.Row="0" Grid.Column="1"
                                          Toggled="Toggle_Changed" />
                            <ToggleSwitch x:Name="DualDeviceSwitch" Header="双设备连接"
                                          Style="{StaticResource AppToggleSwitchStyle}"
                                          Grid.Row="1" Grid.Column="0"
                                          Toggled="Toggle_Changed" />
                            <ToggleSwitch x:Name="InEarSwitch" Header="入耳检测"
                                          Style="{StaticResource AppToggleSwitchStyle}"
                                          Grid.Row="1" Grid.Column="1"
                                          Toggled="Toggle_Changed" />
                            <ToggleSwitch x:Name="WindNoiseSwitch" Header="抗风噪"
                                          Style="{StaticResource AppToggleSwitchStyle}"
                                          Grid.Row="2" Grid.Column="0"
                                          Toggled="Toggle_Changed" />
                        </Grid>
                    <TextBlock x:Name="SaveStatus" AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource AppCardFootnoteStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
