<Page
    x:Class="DeviceCenterPreview.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeviceCenterPreview.App.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Padding="36,28,36,24" Spacing="28"
                    HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="设置" Style="{StaticResource AppPageTitleStyle}" />
                    <TextBlock Text="修改后立即保存并生效；模块关闭后不再扫描对应设备。"
                               Style="{StaticResource AppPageSubtitleStyle}" />
                </StackPanel>
                <controls:StatusChip Grid.Column="1"
                                     Kind="Saved"
                                     Text="更改即时保存"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,4" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="启动" Style="{StaticResource AppSectionTitleStyle}" />
                            <Border Style="{StaticResource AppSettingsRowStyle}"
                                    BorderThickness="0,0,0,0" Padding="0,4">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="开机自启" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="登录 Windows 后自动启动「薄荷外设」。只写入当前用户启动项，不需要管理员权限。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center"
                                                  Toggled="Startup_Toggled" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="StartupStatus"
                                       Style="{StaticResource AppCardFootnoteStyle}"
                                       TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="模块" Style="{StaticResource AppSectionTitleStyle}"
                                       Margin="0,0,0,8" />

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="耳机" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="关闭后停止 SPP 扫描与连接，设备中心不再显示耳机。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HeadsetModuleSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="鼠标" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="关闭后释放 HID++ 会话并停止轮询。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MouseModuleSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="遥控器" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="关闭后停止 Rust 引擎进程与按键监听，重新开启会重启引擎。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RemoteModuleSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSettingsRowStyle}" BorderThickness="0">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="常驻电量监控" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="关闭后停止 VigilWatt 后台发现/采样；三个控制模块仍可单独使用。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MonitorModuleSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="外观" Style="{StaticResource AppSectionTitleStyle}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="主题立即生效；「跟随系统」会随 Windows 的深浅色切换。"
                                       Style="{StaticResource AppCardFootnoteStyle}"
                                       TextWrapping="Wrap" TextTrimming="None"
                                       Margin="0,0,0,8" />
                            <Border Style="{StaticResource AppSettingsRowStyle}" BorderThickness="0">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="主题" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="深色 / 浅色 / 跟随系统可随时切换，设置页与三个设备页会一起换肤。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1"
                                              Width="132"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              VerticalAlignment="Center"
                                              SelectionChanged="Theme_SelectionChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource AppSettingsRowStyle}"
                                    BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="壁纸染色" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="读取桌面壁纸主色，给界面染上一层淡淡的环境色——类 Mica 的静态实现，只在切换时计算一次，没有实时合成开销。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WallpaperTintSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center"
                                                  Toggled="WallpaperTint_Toggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="写入授权" Style="{StaticResource AppSectionTitleStyle}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="关闭后服务层直接拒绝写入并说明原因，不是只把按钮变灰。"
                                       Style="{StaticResource AppCardFootnoteStyle}"
                                       TextWrapping="Wrap" TextTrimming="None"
                                       Margin="0,0,0,8" />

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="耳机写入" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="ANC / EQ / 快捷开关" Style="{StaticResource AppCardFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HeadsetWriteSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Write_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="鼠标写入" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="DPI / 轮询率 / 板载配置" Style="{StaticResource AppCardFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MouseWriteSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Write_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSettingsRowStyle}" BorderThickness="0">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="遥控器写入" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="映射 / 音频 / 语音工具" Style="{StaticResource AppCardFootnoteStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RemoteWriteSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Write_Toggled" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="通知" Style="{StaticResource AppSectionTitleStyle}"
                                       Margin="0,0,0,8" />

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="设备连接时通知" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="设备进入可用状态时在应用内提示。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotifyConnectSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Notify_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="低电量时通知" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="电量低于阈值时提示，阈值可在下方调整。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotifyLowBatterySwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Notify_Toggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AppSettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="写入失败时通知" Style="{StaticResource AppCardTitleStyle}" />
                                        <TextBlock Text="硬件写入失败或回读校验不通过时提示。"
                                                   Style="{StaticResource AppCardFootnoteStyle}"
                                                   TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotifyWriteFailureSwitch" Grid.Column="1"
                                                  Style="{StaticResource AppToggleSwitchStyle}"
                                                  VerticalAlignment="Center" Toggled="Notify_Toggled" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="低电量阈值" Style="{StaticResource AppCardTitleStyle}" />
                                    <TextBlock Text="0 表示不按阈值提醒。" Style="{StaticResource AppCardFootnoteStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="LowBatteryThresholdCombo"
                                              Width="104"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              SelectionChanged="Threshold_SelectionChanged" />
                                    <TextBlock Text="%" VerticalAlignment="Center"
                                               Style="{StaticResource AppCardFootnoteStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="配置备份与恢复" Style="{StaticResource AppSectionTitleStyle}" />
                            <TextBlock Text="备份包含本应用 settings.json 与遥控器配置文件；导入前会校验清单。"
                                       Style="{StaticResource AppCardFootnoteStyle}"
                                       TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <Button x:Name="ExportBackupButton" Grid.Column="1"
                                Content="导出备份"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="ExportBackup_Click" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="BackupCombo"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  PlaceholderText="选择备份文件" />
                        <Button x:Name="ImportBackupButton" Grid.Column="1"
                                Content="导入选中备份"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="ImportBackup_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ResetButton" Content="恢复默认设置"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="Reset_Click" />
                        <Button Content="打开备份目录"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="OpenBackup_Click" />
                        <Button Content="打开配置目录"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="OpenConfig_Click" />
                    </StackPanel>

                    <TextBlock x:Name="BackupStatus"
                               Style="{StaticResource AppCardFootnoteStyle}"
                               TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="诊断" Style="{StaticResource AppSectionTitleStyle}" />
                            <TextBlock Text="诊断包含当前状态摘要与已脱敏日志，不含设备地址、语音内容或输入文本。"
                                       Style="{StaticResource AppCardFootnoteStyle}"
                                       TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <Button x:Name="ExportDiagnosticsButton" Grid.Column="1"
                                Content="导出诊断包"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="ExportDiagnostics_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="打开诊断目录"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="OpenDiagnostics_Click" />
                        <Button Content="打开日志目录"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="OpenLogs_Click" />
                    </StackPanel>
                    <TextBlock x:Name="DiagnosticsStatus"
                               Style="{StaticResource AppCardFootnoteStyle}"
                               TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="SettingsPathText"
                       Style="{StaticResource AppCardFootnoteStyle}"
                       TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
