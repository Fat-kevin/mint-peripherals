<Page
    x:Class="DeviceCenterPreview.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeviceCenterPreview.App.Controls"
    NavigationCacheMode="Required">

    <!--
        设置：分类切换 + 单列分组。每类只放这一件事的控件，页内不再长滚动。
        设备开关按设备成对排列（启用 / 允许写入），不把「模块」和「写入授权」拆成两组。
    -->
    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Padding="32,28,32,24" Spacing="0">

            <!-- 页头 -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="偏好与数据" Style="{StaticResource BenchLabelStyle}" />
                    <TextBlock Text="设置" Style="{StaticResource BenchPageTitleStyle}" />
                    <TextBlock Text="修改后立即保存并生效；模块关闭后不再扫描对应设备。"
                               Style="{StaticResource BenchMetaStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{ThemeResource AppSuccessBrush}" />
                    <TextBlock Text="更改即时保存" Style="{StaticResource BenchFootnoteStyle}" />
                </StackPanel>
            </Grid>

            <!-- 分类 -->
            <Border Background="{ThemeResource AppInsetBrush}" CornerRadius="6" Padding="3"
                    HorizontalAlignment="Left" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="Tab0" Content="外观" Tag="0"
                            Style="{StaticResource BenchSegmentButtonStyle}" Click="Category_Changed" />
                    <Button x:Name="Tab1" Content="启动" Tag="1"
                            Style="{StaticResource BenchSegmentButtonStyle}" Click="Category_Changed" />
                    <Button x:Name="Tab2" Content="设备模块" Tag="2"
                            Style="{StaticResource BenchSegmentButtonStyle}" Click="Category_Changed" />
                    <Button x:Name="Tab3" Content="写入授权" Tag="3"
                            Style="{StaticResource BenchSegmentButtonStyle}" Click="Category_Changed" />
                    <Button x:Name="Tab4" Content="通知" Tag="4"
                            Style="{StaticResource BenchSegmentButtonStyle}" Click="Category_Changed" />
                    <Button x:Name="Tab5" Content="备份与诊断" Tag="5"
                            Style="{StaticResource BenchSegmentButtonStyle}" Click="Category_Changed" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,0" ColumnSpacing="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource BenchPanelStyle}" Margin="0,20,0,0" VerticalAlignment="Top">
                    <StackPanel Spacing="0">

            <!-- 外观 -->
            <StackPanel x:Name="Category0" Spacing="0" Margin="0,22,0,0">
                <TextBlock Text="主题" Style="{StaticResource BenchValueStyle}" />
                <TextBlock Text="深色 / 浅色 / 跟随系统；切换后整个窗口立即换肤。"
                           Style="{StaticResource BenchFootnoteStyle}" Margin="0,2,0,0" />
                <ComboBox x:Name="ThemeCombo" Width="180" HorizontalAlignment="Left" Margin="0,8,0,0"
                          Style="{StaticResource BenchComboBoxStyle}"
                          SelectionChanged="Theme_SelectionChanged" />
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,18,0,0" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="壁纸染色" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="读取桌面壁纸主色，给界面染一层环境色；只在切换时计算一次。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="WallpaperTintSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="WallpaperTint_Toggled" />
                </Grid>
            </StackPanel>

            <!-- 启动 -->
            <StackPanel x:Name="Category1" Spacing="0" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="开机自启" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="登录 Windows 后自动启动；只写当前用户启动项，不需要管理员权限。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Startup_Toggled" />
                </Grid>
                <TextBlock x:Name="StartupStatus" Style="{StaticResource BenchFootnoteStyle}"
                           Margin="0,10,0,0" />
            </StackPanel>

            <!-- 设备模块 -->
            <StackPanel x:Name="Category2" Spacing="0" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="耳机" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="关闭后停止 SPP 扫描与连接，设备栏不再显示耳机。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HeadsetModuleSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="鼠标" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="关闭后释放 HID++ 会话并停止轮询。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MouseModuleSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="遥控器" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="关闭后停止 Rust 引擎与按键监听；重新开启会重启引擎。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RemoteModuleSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="常驻电量监控" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="关闭后停止后台发现与采样；三个控制模块仍可单独使用。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MonitorModuleSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Module_Toggled" />
                </Grid>
            </StackPanel>

            <!-- 写入授权 -->
            <StackPanel x:Name="Category3" Spacing="0" Margin="0,22,0,0" Visibility="Collapsed">
                <TextBlock Text="关闭后服务层直接拒绝写入并说明原因，不是只把按钮变灰。"
                           Style="{StaticResource BenchFootnoteStyle}" Margin="0,0,0,6" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="耳机写入" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="ANC / EQ / 快捷开关"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HeadsetWriteSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Write_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="鼠标写入" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="DPI / 轮询率 / 板载配置"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MouseWriteSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Write_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="遥控器写入" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="映射 / 音频 / 语音工具"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RemoteWriteSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Write_Toggled" />
                </Grid>
            </StackPanel>

            <!-- 通知 -->
            <StackPanel x:Name="Category4" Spacing="0" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="设备连接时通知" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="设备进入可用状态时在应用内提示。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="NotifyConnectSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Notify_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="低电量时通知" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="电量低于阈值时提示。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="NotifyLowBatterySwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Notify_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="写入失败时通知" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="硬件写入失败或回读校验不通过时提示。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="NotifyWriteFailureSwitch" Grid.Column="1"
                                  Style="{StaticResource BenchToggleSwitchStyle}"
                                  VerticalAlignment="Center" Toggled="Notify_Toggled" />
                </Grid>
                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="低电量阈值" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="0 表示不按阈值提醒。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <ComboBox x:Name="LowBatteryThresholdCombo" Width="110"
                                  Style="{StaticResource BenchComboBoxStyle}"
                                  SelectionChanged="Threshold_SelectionChanged" />
                        <TextBlock Text="%" Style="{StaticResource BenchFootnoteStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 备份与诊断 -->
            <StackPanel x:Name="Category5" Spacing="0" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExportBackupButton" Content="导出备份"
                            Style="{StaticResource BenchOutlineButtonStyle}"
                            Click="ExportBackup_Click" />
                    <ComboBox x:Name="BackupCombo" Grid.Column="1" Margin="10,0,0,0"
                              Style="{StaticResource BenchComboBoxStyle}"
                              PlaceholderText="选择备份文件" />
                    <Button x:Name="ImportBackupButton" Grid.Column="2" Content="导入选中备份"
                            Style="{StaticResource BenchOutlineButtonStyle}"
                            Click="ImportBackup_Click" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                    <Button x:Name="ResetButton" Content="恢复默认设置"
                            Style="{StaticResource BenchGhostButtonStyle}"
                            Click="Reset_Click" />
                    <Button Content="打开备份目录" Style="{StaticResource BenchGhostButtonStyle}"
                            Click="OpenBackup_Click" />
                    <Button Content="打开配置目录" Style="{StaticResource BenchGhostButtonStyle}"
                            Click="OpenConfig_Click" />
                    <Button Content="打开日志目录" Style="{StaticResource BenchGhostButtonStyle}"
                            Click="OpenLogs_Click" />
                </StackPanel>
                <TextBlock x:Name="BackupStatus" Style="{StaticResource BenchFootnoteStyle}"
                           Margin="0,8,0,0" />

                <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,18,0,16" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="诊断包" Style="{StaticResource BenchValueStyle}" />
                        <TextBlock Text="含当前状态摘要与已脱敏日志，不含设备地址、语音内容或输入文本。"
                                   Style="{StaticResource BenchFootnoteStyle}" />
                        <TextBlock x:Name="DiagnosticsStatus" Style="{StaticResource BenchFootnoteStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <Button x:Name="ExportDiagnosticsButton" Grid.Column="1" Content="导出诊断包"
                            VerticalAlignment="Top" Margin="0,0,10,0"
                            Style="{StaticResource BenchOutlineButtonStyle}"
                            Click="ExportDiagnostics_Click" />
                    <Button Grid.Column="2" Content="打开诊断目录" VerticalAlignment="Top"
                            Style="{StaticResource BenchGhostButtonStyle}"
                            Click="OpenDiagnostics_Click" />
                </Grid>

                <TextBlock x:Name="SettingsPathText" Style="{StaticResource BenchFootnoteStyle}"
                           Margin="0,22,0,0" />
            </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 常驻状态 -->
                <Border Grid.Column="1" Style="{StaticResource BenchPanelStyle}" Margin="0,20,0,0" VerticalAlignment="Top">
                    <StackPanel Spacing="0">
                    <TextBlock Text="运行状态" Style="{StaticResource BenchSectionTitleStyle}" />
                    <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,8,0,0" />
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="本地引擎" Style="{StaticResource BenchLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                     Fill="{ThemeResource AppSuccessBrush}" />
                            <TextBlock Text="运行中" Style="{StaticResource BenchValueStyle}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="链路" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock Text="SPP / HID++ / BLE" HorizontalAlignment="Right"
                                   Style="{StaticResource BenchValueStyle}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="数据" Style="{StaticResource BenchLabelStyle}" />
                        <TextBlock Text="真实设备" HorizontalAlignment="Right"
                                   Style="{StaticResource BenchValueStyle}" />
                    </Grid>

                    <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,18,0,14" />
                    <TextBlock Style="{StaticResource BenchFootnoteStyle}"
                               Text="读数全部来自真实设备；未接入的能力会在对应页面禁用并说明原因，不显示演示数据。" />
                    <Border Style="{StaticResource BenchSectionRuleStyle}" Margin="0,16,0,12" />
                    <Button Content="打开配置目录" HorizontalAlignment="Stretch"
                            Style="{StaticResource BenchGhostButtonStyle}"
                            Click="OpenConfig_Click" />
                    <Button Content="打开日志目录" HorizontalAlignment="Stretch" Margin="0,2,0,0"
                            Style="{StaticResource BenchGhostButtonStyle}"
                            Click="OpenLogs_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
