<Window
    x:Class="DeviceCenterPreview.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="薄荷外设">



    <Grid x:Name="Root" Background="{ThemeResource AppCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 图标栏：品牌 / 设备导航 / 设置 / 引擎 ===== -->
        <Grid Grid.Column="0" Background="{ThemeResource AppChromeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
            <!-- 低对比环境光；只做氛围，不承载信息 -->
            <Ellipse Grid.RowSpan="3" Width="760" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-220,-200,0,0" IsHitTestVisible="False" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2A5FE0BE" Offset="0" />
                        <GradientStop Color="#005FE0BE" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Grid.RowSpan="3" Width="680" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-220,-180" IsHitTestVisible="False" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1E6FA8FF" Offset="0" />
                        <GradientStop Color="#006FA8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            </Grid>

            <Border Width="1" HorizontalAlignment="Right" Grid.RowSpan="3"
                    Background="{ThemeResource AppBorderSubtleBrush}" />

            <Border Grid.Row="0" Width="38" Height="38" CornerRadius="10"
                    Margin="0,20,0,0" HorizontalAlignment="Center"
                    Background="{ThemeResource AppIonBrush}">
                <TextBlock Text="薄" FontFamily="{ThemeResource AppDisplayFont}" FontSize="16"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource AppOnInkBrush}" />
            </Border>

            <StackPanel x:Name="RailNavStack" Grid.Row="1" Margin="0,28,0,0" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="OverviewNav" Style="{StaticResource RailNavButtonStyle}"
                        Click="Overview_Click" AutomationProperties.Name="设备总览"
                        ToolTipService.ToolTip="设备总览">
                    <FontIcon Glyph="&#xE80F;" FontSize="18"
                              Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </Button>

                <Button x:Name="HeadsetNav" Style="{StaticResource RailNavButtonStyle}"
                        Tag="headset" Click="DeviceNav_Click" AutomationProperties.Name="耳机工作区"
                        ToolTipService.ToolTip="耳机">
                    <Grid Width="30" Height="30">
                        <FontIcon Glyph="{StaticResource AppIconHeadsetGlyph}" FontSize="18"
                                  Foreground="{ThemeResource AppTextSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="HeadsetNavDot" Width="6" Height="6"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{ThemeResource AppOfflineBrush}" />
                    </Grid>
                </Button>

                <Button x:Name="MouseNav" Style="{StaticResource RailNavButtonStyle}"
                        Tag="mouse" Click="DeviceNav_Click" AutomationProperties.Name="鼠标工作区"
                        ToolTipService.ToolTip="鼠标">
                    <Grid Width="30" Height="30">
                        <FontIcon Glyph="{StaticResource AppIconMouseGlyph}" FontSize="18"
                                  Foreground="{ThemeResource AppTextSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="MouseNavDot" Width="6" Height="6"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{ThemeResource AppOfflineBrush}" />
                    </Grid>
                </Button>

                <Button x:Name="RemoteNav" Style="{StaticResource RailNavButtonStyle}"
                        Tag="remote" Click="DeviceNav_Click" AutomationProperties.Name="遥控器工作区"
                        ToolTipService.ToolTip="遥控器">
                    <Grid Width="30" Height="30">
                        <FontIcon Glyph="{StaticResource AppIconRemoteGlyph}" FontSize="18"
                                  Foreground="{ThemeResource AppTextSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="RemoteNavDot" Width="6" Height="6"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{ThemeResource AppOfflineBrush}" />
                    </Grid>
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,14" Spacing="10" HorizontalAlignment="Center">
                <Button x:Name="SettingsNav" Style="{StaticResource RailNavButtonStyle}"
                        Click="Settings_Click" AutomationProperties.Name="设置"
                        ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="{StaticResource AppIconSettingsGlyph}" FontSize="18"
                              Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </Button>
                <Ellipse x:Name="EngineDot" Width="6" Height="6"
                         Fill="{ThemeResource AppSuccessBrush}"
                         ToolTipService.ToolTip="本地引擎运行中" />
            </StackPanel>
        </Grid>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent" />

            <muxc:InfoBar x:Name="AppInfoBar" Grid.Row="1"
                          IsOpen="False" IsClosable="True" Severity="Informational"
                          HorizontalAlignment="Stretch" Margin="32,0,32,8" />

            <muxc:Frame x:Name="ContentFrame" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
