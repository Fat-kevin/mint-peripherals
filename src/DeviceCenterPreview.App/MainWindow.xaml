<Window
    x:Class="DeviceCenterPreview.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="薄荷外设">

    <Grid x:Name="Root" Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource AppTitleBarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/PeripheralHub-16.png" Width="16" Height="16" />
                <TextBlock Text="薄荷外设"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                <Border Width="1" Height="12" Margin="2,0"
                        Background="{ThemeResource AppBorderSubtleBrush}" />
                <TextBlock Text="设备控制台"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource AppTextTertiaryBrush}" />
            </StackPanel>

        </Grid>

        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             IsPaneToggleButtonVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="240"
                             IsPaneOpen="True"
                             AlwaysShowHeader="False"
                             SelectionChanged="Nav_SelectionChanged">

            <muxc:NavigationView.PaneHeader>
                <Grid Margin="18,18,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12"
                            Background="{ThemeResource AppAccentGradientBrush}">
                        <Image Source="ms-appx:///Assets/PeripheralHub-32.png"
                               Width="22" Height="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="薄荷外设"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="设备控制台"
                                   Style="{StaticResource AppOverlineStyle}" />
                    </StackPanel>
                </Grid>
            </muxc:NavigationView.PaneHeader>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="设备中心" Tag="hub" IsSelected="True"
                                         Style="{StaticResource AppNavigationViewItemStyle}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="{StaticResource AppIconHubGlyph}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="耳机" Tag="headset"
                                         Style="{StaticResource AppNavigationViewItemStyle}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="{StaticResource AppIconHeadsetGlyph}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="鼠标" Tag="mouse"
                                         Style="{StaticResource AppNavigationViewItemStyle}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="{StaticResource AppIconMouseGlyph}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="遥控器" Tag="remote"
                                         Style="{StaticResource AppNavigationViewItemStyle}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="{StaticResource AppIconRemoteGlyph}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="设置" Tag="settings" Margin="12,22,12,2"
                                         Style="{StaticResource AppNavigationViewItemStyle}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontSize="18" Glyph="{StaticResource AppIconSettingsGlyph}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <Border Margin="14,0,14,14" Padding="12,10" CornerRadius="12"
                        Background="{ThemeResource AppNavActiveBrush}"
                        BorderBrush="{ThemeResource AppNavActiveBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7"
                                     Fill="{ThemeResource AppSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="本地引擎"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            <TextBlock Text="运行中"
                                       FontSize="11"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="v1.0.6"
                                   Style="{StaticResource AppCaptionStyle}" />
                    </StackPanel>
                </Border>
            </muxc:NavigationView.PaneFooter>

            <Grid Background="{ThemeResource AppCanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" Height="280" VerticalAlignment="Top"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#160E9A76" Offset="0" />
                            <GradientStop Color="#000E9A76" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <muxc:InfoBar x:Name="AppInfoBar"
                              Grid.Row="0"
                              IsOpen="False"
                              IsClosable="True"
                              Severity="Informational"
                              HorizontalAlignment="Stretch"
                              Margin="32,8,32,0" />

                <muxc:Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
