<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        「台面 / Bench」视觉系统（2026-11 重做）。
        墨色骨架 + 纸白表面 + 设备身份色 + 深绿品牌强调。
        交互与选中一律用墨色；强调色只做「在线 / 焦点 / 链接」三种信号。
        两套主题的键必须完全一致，缺键会在运行期解析失败。
    -->
