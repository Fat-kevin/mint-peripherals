<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppPrimaryFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter
                            x:Name="Content"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppPrimaryFillHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AppPrimaryFillPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppHoverBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="AppTertiaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="AppIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="AppPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    
    <Style x:Key="AppToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                        
                        <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                        <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="KnobHost"
                        Storyboard.TargetProperty="Width"
                        To="20" Duration="0:0:0.1" EnableDependentAnimation="True" />
                        <DoubleAnimation Storyboard.TargetName="KnobHost"
                        Storyboard.TargetProperty="Height"
                        To="20" Duration="0:0:0.1" EnableDependentAnimation="True" />
                        </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                        <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="KnobHost"
                        Storyboard.TargetProperty="Width"
                        To="16" Duration="0" EnableDependentAnimation="True" />
                        <DoubleAnimation Storyboard.TargetName="KnobHost"
                        Storyboard.TargetProperty="Height"
                        To="16" Duration="0" EnableDependentAnimation="True" />
                        </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                        <Setter Target="SwitchArea.Opacity" Value="0.45" />
                        </VisualState.Setters>
                        </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="ToggleStates">
                        <VisualState x:Name="Dragging" />
                        <VisualState x:Name="Off">
                        <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="Background">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleSwitchFillOff}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob" Storyboard.TargetProperty="Fill">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleSwitchKnobFillOff}" />
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="KnobTranslate"
                        Storyboard.TargetProperty="X"
                        To="0" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                        <QuadraticEase />
                        </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        </Storyboard>
                        </VisualState>
                        <VisualState x:Name="On">
                        <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="Background">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleSwitchFillOn}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Knob" Storyboard.TargetProperty="Fill">
                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToggleSwitchKnobFillOn}" />
                        </ObjectAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="KnobTranslate"
                        Storyboard.TargetProperty="X"
                        To="20" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                        <QuadraticEase />
                        </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        </Storyboard>
                        </VisualState>
                        </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          FontWeight="SemiBold" FontSize="13"
                                          Foreground="{ThemeResource AppTextPrimaryBrush}"
                                          Margin="0,0,0,8" />
                        <Grid x:Name="SwitchArea" Width="44" Height="24" HorizontalAlignment="Left"
                              Background="Transparent" CornerRadius="12">
                            <Border x:Name="Track" CornerRadius="12"
                                    Background="{ThemeResource ToggleSwitchFillOff}" />
                            <Grid x:Name="KnobHost" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslate" />
                                </Grid.RenderTransform>
                                <Ellipse x:Name="Knob" Fill="{ThemeResource ToggleSwitchKnobFillOff}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{ThemeResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{ThemeResource AppInputBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="AppSliderStyle" TargetType="Slider">
        <Setter Property="MinHeight" Value="32" />
    </Style>
</ResourceDictionary>
