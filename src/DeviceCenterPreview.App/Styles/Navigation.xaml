<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2C3834" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#232F28" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#304B40" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#223229" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#B5C3BC" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F2F1EA" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#A2D5B9" />
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelected" Color="#2E4137" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#A2D5B9" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#111716" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#161C1B" />
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#1E2A24" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#F2F8F4" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#E4EFE8" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#F9FAF5" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#F9FAF5" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#40564B" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1E2C26" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#22664D" />
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelected" Color="#E2ECE6" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#22664D" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#E3E9E2" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F0F2EC" />
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#DCE8E1" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="AppNavigationViewItemStyle" TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
    </Style>
</ResourceDictionary>
