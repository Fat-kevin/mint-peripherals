<UserControl
    x:Class="DeviceCenterPreview.App.Controls.StatusChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- 极简状态：彩色圆点 + 同色文字，无底无框（用户否定胶囊形）。 -->
    <StackPanel x:Name="ChipRoot"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">
        <Grid Width="14" Height="14" VerticalAlignment="Center">
            <Ellipse x:Name="DotOuter" Width="14" Height="14" Opacity="0.18" Visibility="Collapsed" />
            <Ellipse x:Name="Dot" Width="7" Height="7" />
        </Grid>
        <TextBlock x:Name="ChipText"
                   Style="{StaticResource AppCardLabelStyle}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold" />
    </StackPanel>
</UserControl>
